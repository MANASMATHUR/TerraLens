# Flagsmith Configuration
# Get these from your Flagsmith Project: https://app.flagsmith.com/
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY=
FLAGSMITH_SERVER_KEY=
FLAGSMITH_MASTER_API_KEY=
FLAGSMITH_EXPERIMENT_ID=581
NEXT_PUBLIC_FLAGSMITH_PROJECT_ID=55892
ADMIN_AUDIT_SECRET=

# Names referenced by the app. Only the strategy flag is present in the live project;
# model-config and consequence-fallback flags are optional and currently absent.
NEXT_PUBLIC_FLAG_STRATEGY=incident_prioritization_strategy
NEXT_PUBLIC_FLAG_MODEL_CONFIG=incident_prioritization_model_config
NEXT_PUBLIC_FLAG_CONSEQUENCE_FALLBACK=incident_consequence_fallback_enabled
NEXT_PUBLIC_METRIC_TASK_SUBMITTED=priority_task_submitted
NEXT_PUBLIC_METRIC_TASK_SUCCESS=priority_task_success
NEXT_PUBLIC_METRIC_TASK_DURATION=task_duration_seconds

# Supabase + PostGIS Configuration
# Get these from your Supabase Project Settings > API / Database: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenFreeMap Vector Basemap (100% Free & Open-Source, No API Key Required)
# Vector style URL: https://tiles.openfreemap.org/styles/dark
